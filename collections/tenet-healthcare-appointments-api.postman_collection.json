  "info": {
    "_postman_id": "a5ee2f26-cd32-4e60-9c34-2abe30bdeb19",
    "name": "Tenet Healthcare FHIR R4 Patient Appointments API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "HL7 FHIR R4 compliant patient API for Tenet Health hospital network enabling access to patient demographics, appointments, clinical observations, conditions, medications, allergies, care plans, and document references. Supports patient portal integration, care team communication, and interoperability with electronic health record systems. Implements SMART on FHIR for secure authorization.\n\nContact Support:\n Name: Tenet Health Digital Health",
      "type": "text/plain"
    }
  }
